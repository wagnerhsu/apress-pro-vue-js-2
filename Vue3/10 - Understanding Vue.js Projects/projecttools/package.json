{
  "name": "projecttools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preview": "vite preview",
    "serve": "vite",
    "build": "vite build",
    "dev": "vite"
  },
  "dependencies": {
    "vuex": "^3.0.1",
    "vue-router": "^3.0.1",
    "@vue/compat": "^3.5.33",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.33",
    "connect-history-api-fallback": "^1.5.0",
    "vite": "^8.0.10",
    "autoprefixer": "^10.4.21",
    "express": "^4.16.3",
    "@vitejs/plugin-vue": "^6.0.6"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "vue/html-indent": "off",
      "vue/v-on-style": [
        "warn",
        "longform"
      ]
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
