{
  "name": "productapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preview": "vite preview",
    "json": "json-server restData.js -p 3500",
    "serve": "vite",
    "build": "vite build",
    "start": "concurrently \"npm run json\" \"npm run serve\"",
    "dev": "vite"
  },
  "dependencies": {
    "concurrently": "^7.4.0",
    "webpack": "4.0.0",
    "json-server": "^0.12.1",
    "vuex": "^4.1.0",
    "popper.js": "1.16.1",
    "vue": "^3.5.33",
    "axios": "^0.18.0",
    "cache-loader": "^4.1.0",
    "jquery": "1.9.1",
    "@vue/compat": "^3.5.33",
    "bootstrap": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^8.0.10",
    "@vue/compiler-sfc": "^3.5.33",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.21"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "no-unused-vars": "off"
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
